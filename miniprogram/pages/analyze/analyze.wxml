<view class="main-content">
  <view class="filter-card">
    <view class="filter-head">
      <view>
        <view class="section-title">统计区间</view>
        <view class="section-subtitle">使用统一口径查看最近 7 / 30 / 90 / 365 天趋势</view>
      </view>
    </view>

    <view class="period-selector">
      <view
        wx:for="{{periodList}}"
        wx:key="key"
        class="period-pill {{selectedRangeKey === item.key ? 'active' : ''}}"
        bindtap="changePeriod"
        data-key="{{item.key}}"
        data-days="{{item.days}}"
      >
        {{item.label}}
      </view>
    </view>

    <view class="range-summary">
      <view class="range-summary-text">{{currentDateRange}}</view>
      <view class="range-summary-meta">已记录 {{trendSummary.recordedDays}} / {{trendSummary.totalDays}} 天</view>
    </view>
  </view>

  <view class="chart-container">
    <view class="chart-header">
      <view>
        <view class="section-title">热量趋势</view>
        <view class="section-subtitle">折线图展示摄入与消耗变化，目标线用于判断是否偏高</view>
      </view>
      <view class="target-badge">目标 {{calorieTarget}} 千卡</view>
    </view>

    <view class="overview-grid">
      <view class="overview-card">
        <view class="overview-label">总摄入</view>
        <view class="overview-value intake">{{trendSummary.totalIntake}}</view>
      </view>
      <view class="overview-card">
        <view class="overview-label">总消耗</view>
        <view class="overview-value burned">{{trendSummary.totalBurned}}</view>
      </view>
      <view class="overview-card">
        <view class="overview-label">日均净摄入</view>
        <view class="overview-value net">{{trendSummary.averageNetCalories}}</view>
      </view>
      <view class="overview-card">
        <view class="overview-label">记录覆盖率</view>
        <view class="overview-value record">{{trendSummary.recordRate}}%</view>
      </view>
    </view>

    <view class="chart-panel">
      <ec-canvas
        id="calorie-trend-chart"
        canvas-id="calorie-trend-chart"
        class="trend-chart"
        echarts="{{echarts}}"
        ec="{{ec}}"
      ></ec-canvas>
      <view wx:if="{{isLoadingTrend}}" class="chart-overlay">
        <text>正在加载趋势数据...</text>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <view class="value">{{stats.averageDailyIntake}}</view>
      <view class="label">平均每日摄入</view>
    </view>
    <view class="stat-card">
      <view class="value">{{stats.overStandardDays}}</view>
      <view class="label">超标天数</view>
    </view>
    <view class="stat-card">
      <view class="value">{{stats.highestIntake}}</view>
      <view class="label">最高摄入 (千卡)</view>
    </view>
    <view class="stat-card">
      <view class="value">{{stats.lowestIntake}}</view>
      <view class="label">最低摄入 (千卡)</view>
    </view>
  </view>
</view>
